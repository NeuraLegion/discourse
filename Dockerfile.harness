FROM bright-app-local

WORKDIR /app

ENV RAILS_ENV=production \
    RACK_ENV=production \
    RAILS_LOG_TO_STDOUT=1 \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_FROZEN=false \
    DISABLE_BOOTSNAP=1 \
    PORT=3001

# Install harness-only runtime gems into the app bundle context so they are
# available after Bundler sets up the locked application environment.
RUN gem install sinatra -v 3.2.0 --no-document \
 && gem install rack-protection -v 3.2.0 --no-document \
 && gem install rack-session -v 1.0.2 --no-document \
 && gem install tilt --no-document

COPY harness.rb /app/harness.rb

EXPOSE 3001

CMD ["bundle", "exec", "ruby", "harness.rb"]
