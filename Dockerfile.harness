FROM ruby:3.4-slim

ENV DEBIAN_FRONTEND=noninteractive \
    BUNDLE_GEMFILE="" \
    RUBYLIB=/app/lib \
    PORT=3001

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      libpq-dev \
      pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN gem update --system --no-document && \
    gem install --no-document \
      rack \
      webrick \
      sinatra \
      activesupport \
      mini_mime \
      nokogiri \
      excon \
      addressable \
      loofah \
      pg \
      ipaddr \
      rate_limiter

COPY . /app
COPY harness.rb /app/harness.rb

EXPOSE 3001

CMD ["ruby", "harness.rb"]
