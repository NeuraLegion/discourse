FROM ruby:3.4-slim

ENV DEBIAN_FRONTEND=noninteractive \
    BUNDLE_GEMFILE="" \
    RUBYLIB=/app/lib \
    RACKUP_HANDLER=webrick \
    PORT=3001

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      pkg-config \
      ca-certificates \
      libxml2-dev \
      libxslt1-dev \
      zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN gem install --no-document \
      sinatra \
      activesupport \
      activemodel \
      activerecord \
      railties \
      pg \
      addressable \
      mini_mime \
      nokogiri \
      loofah \
      excon \
      mini_racer \
      webrick

COPY . /app
COPY harness.rb /app/harness.rb

EXPOSE 3001

CMD ["ruby", "harness.rb"]
