FROM ruby:3.4-slim

ENV DEBIAN_FRONTEND=noninteractive \
    BUNDLE_GEMFILE="" \
    RUBYLIB=/app/lib \
    PORT=3001

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN gem install --no-document \
      sinatra \
      addressable \
      activesupport \
      activerecord \
      pg \
      excon \
      nokogiri \
      rack \
      rackup \
      puma

COPY . /app
COPY harness.rb /app/harness.rb

EXPOSE 3001

CMD ["ruby", "harness.rb"]
