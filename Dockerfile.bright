FROM ruby:3.4-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    BUNDLE_PATH=/bundle \
    BUNDLE_BIN=/bundle/bin \
    GEM_HOME=/bundle \
    PATH=/bundle/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/local/node/bin \
    RAILS_ENV=production \
    RACK_ENV=production \
    NODE_ENV=production \
    DISCOURSE_ENV=production \
    SECRET_KEY_BASE=dummy-secret-key-base-for-dast-testing \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_JOBS=4 \
    MAKEFLAGS="-j$(nproc)" \
    CARGO_BUILD_JOBS=$(nproc) \
    DISCOURSE_HOSTNAME=localhost

WORKDIR /app

COPY --from=node:22-bookworm /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-bookworm /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/bin/node /usr/local/bin/nodejs \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
    && npm install -g pnpm@10.28.0 \
    && ln -sf /usr/bin/gm /usr/local/bin/magick

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      git \
      curl \
      ca-certificates \
      gnupg \
      pkg-config \
      postgresql-client \
      libpq-dev \
      libyaml-dev \
      libxml2-dev \
      libxslt1-dev \
      zlib1g-dev \
      libffi-dev \
      libgmp-dev \
      libgdbm-dev \
      libreadline-dev \
      libsqlite3-dev \
      libvips-dev \
      graphicsmagick-imagemagick-compat \
      fonts-noto \
      fonts-liberation \
      libjemalloc2 \
    && rm -rf /var/lib/apt/lists/*

COPY Gemfile Gemfile.lock package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY patches patches
COPY frontend/discourse/package.json frontend/discourse/package.json
COPY frontend/pretty-text/package.json frontend/pretty-text/package.json
COPY frontend/discourse-types/package.json frontend/discourse-types/package.json
COPY frontend/discourse-markdown-it/package.json frontend/discourse-markdown-it/package.json
COPY frontend/discourse-i18n/package.json frontend/discourse-i18n/package.json
COPY frontend/deprecation-silencer/package.json frontend/deprecation-silencer/package.json
COPY frontend/custom-proxy/package.json frontend/custom-proxy/package.json
COPY frontend/asset-processor/package.json frontend/asset-processor/package.json
COPY frontend/ember-cli-progress-ci/package.json frontend/ember-cli-progress-ci/package.json
COPY docs/developer-guides/package.json docs/developer-guides/package.json
COPY . .

RUN bundle config set --local path "$BUNDLE_PATH" \
    && bundle config set --local without "$BUNDLE_WITHOUT" \
    && bundle config set --local jobs "$(nproc)" \
    && bundle install

RUN pnpm install --frozen-lockfile

RUN sed -i 's/host: 127.0.0.1/host: 0.0.0.0/g' config/puma.rb 2>/dev/null || true \
    && sed -i 's/localhost/db/g' config/database.yml 2>/dev/null || true

EXPOSE 3000

CMD ["bash", "-lc", "UNICORN_BIND_ALL=true bundle exec pitchfork -c config/pitchfork.conf.rb"]
